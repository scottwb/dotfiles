# Conversation history and session data
history.jsonl
projects/
debug/
file-history/
sessions/
session-env/
shell-snapshots/
todos/
uploads/

# Claude Code's own runtime plans dir. Anchored: an unanchored `plans/`
# also matches nested dirs, which is how docs/plans/ used to get swallowed.
/plans/

# Caches and transient state
backups/
cache/
image-cache/
paste-cache/
stats-cache.json
tasks/
telemetry/
.last-cleanup
.last-update-result.json
mcp-needs-auth-cache.json

# Analytics and feature flags
statsig/

# IDE integration state
ide/

# Plugin runtime state (can be re-fetched)
plugins/cache/
plugins/repos/
plugins/installed_plugins.json
plugins/known_marketplaces.json
plugins/marketplaces/
plugins/blocklist.json
plugins/.last_inuse_sweep

# security-guidance plugin state. Ignored for a stronger reason than the rest
# of this list: its warnings-state JSON records `untracked_at_baseline`, the
# filenames present when a session started, from WHATEVER repo that session was
# in. Committing it would publish client and project filenames into this PUBLIC
# repo. Observed doing exactly that on 2026-07-31, carrying a filename from an
# unrelated repo whose baseline SHA does not even exist here.
security/

# Backup files
*.bak

# Symlink artifact
.claude
