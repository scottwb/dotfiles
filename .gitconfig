[user]
	name = Scott W. Bradley
	email = scottwb@example.com
[gpg]
    format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.ssh/allowed_signers
[color]
	ui = auto
[github]
	user = scottwb
	password = !security 2>&1 >/dev/null find-generic-password -gs github.password | ruby -e 'print $1 if STDIN.gets =~ /^password: \\\"(.*)\\\"$/'
[alias]
	ci = commit -a
	stat = status -s
	co = checkout
	unadd = reset HEAD
[push]
	default = simple
	autoSetupRemote = true
	recurseSubmodules = check
[credential]
    helper = osxkeychain
# Written by the Heroku CLI, which appends it to the end of this file. Moved up
# here so the include below stays last; if it reappears at the bottom, a heroku
# command put it back and this is the copy to keep.
[credential "https://git.heroku.com"]
	helper = !heroku git:credentials
[init]
	defaultBranch = main
[pull]
	rebase = false
[commit]
	gpgSign = false
[gui]
	pruneduringfetch = true
[smartgit "submodule"]
	fetchalways = false
	update = true
	initializenew = true

# Machine-local overrides (real email, etc). Must stay LAST so its
# values win. Create on each machine; never committed. See README.
[include]
	path = ~/.gitconfig.local
