#!/usr/bin/env bash
#
# claude-route-selftest - Verify the claude-run route launcher resolves correctly
#                         without launching a session or spending a token.
#
# Every assertion here runs against CLAUDE_ROUTE_DRYRUN=1, which is the whole
# point of building dry-run mode first: the launcher family stays testable
# without a live Ollama server, an OpenRouter key, or any inference cost.
#
# Usage: bin/claude-route-selftest
# Exit:  0 if every assertion passes, 1 otherwise.
#
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CLAUDE_RUN="$SCRIPT_DIR/claude-run"

PASS=0
FAIL=0
FAILED_NAMES=""

# ---------------------------------------------------------------- assertions

SKIP=0

ok()   { PASS=$((PASS + 1)); printf '  \033[32m✓\033[0m %s\n' "$1"; }
bad()  {
  FAIL=$((FAIL + 1))
  FAILED_NAMES="${FAILED_NAMES}\n    - $1"
  printf '  \033[31m✗\033[0m %s\n' "$1"
  [ -n "${2:-}" ] && printf '      %s\n' "$2"
  return 0
}
skip() {
  SKIP=$((SKIP + 1))
  printf '  \033[33m-\033[0m %s \033[2m(skipped: %s)\033[0m\n' "$1" "$2"
}

# assert_contains <description> <haystack> <needle>
assert_contains() {
  case "$2" in
    *"$3"*) ok "$1" ;;
    *)      bad "$1" "expected to find: $3" ;;
  esac
}

# assert_not_contains <description> <haystack> <needle>
assert_not_contains() {
  case "$2" in
    *"$3"*) bad "$1" "should NOT contain: $3" ;;
    *)      ok "$1" ;;
  esac
}

# assert_exit <description> <expected_code> <actual_code>
assert_exit() {
  if [ "$2" = "$3" ]; then ok "$1"; else bad "$1" "expected exit $2, got $3"; fi
}

section() { printf '\n\033[1m%s\033[0m\n' "$1"; }

# ---------------------------------------------------------------- preflight

if [ ! -x "$CLAUDE_RUN" ]; then
  printf '\n\033[31m✗ FAIL\033[0m: %s is missing or not executable.\n\n' "$CLAUDE_RUN"
  exit 1
fi

printf '\n\033[1mclaude-route-selftest\033[0m  (dry run only, nothing is launched)\n'

# Credential resolution is under test, so start from none. A routed session
# exports ANTHROPIC_AUTH_TOKEN to its children, and a dev may have
# OPENROUTER_API_KEY in their shell; either would silently change what the
# assertions below observe. Every test that wants a credential sets its own.
# The same goes for the 1Password location, which a dev sets in their shell.
unset OPENROUTER_API_KEY ANTHROPIC_AUTH_TOKEN CLAUDE_ROUTE_OP_ACCOUNT CLAUDE_ROUTE_OP_REF

# ---------------------------------------------------------------- glm / ollama

section "Alias 'glm' resolves to the local Ollama backend"

glm_out="$(CLAUDE_ROUTE_DRYRUN=1 "$CLAUDE_RUN" glm 2>&1)"
glm_rc=$?

assert_exit      "dry run exits 0"                "0" "$glm_rc"
assert_contains  "names the alias"                "$glm_out" "glm"
assert_contains  "provider is ollama"             "$glm_out" "ollama"
assert_contains  "base URL is the Ollama default" "$glm_out" "http://localhost:11434"
assert_contains  "model id is glm-4.7-flash"      "$glm_out" "glm-4.7-flash"
assert_contains  "context is the Gate A value"    "$glm_out" "202752"
assert_contains  "permission mode is present"     "$glm_out" "--dangerously-skip-permissions"
assert_contains  "haiku tier is mapped"           "$glm_out" "ANTHROPIC_DEFAULT_HAIKU_MODEL"
assert_contains  "context override is set"        "$glm_out" "CLAUDE_CODE_MAX_CONTEXT_TOKENS"

# ---------------------------------------------------------------- gpt / openrouter

section "Alias 'gpt' resolves to OpenRouter"

gpt_out="$(CLAUDE_ROUTE_DRYRUN=1 "$CLAUDE_RUN" gpt 2>&1)"
gpt_rc=$?

assert_exit      "dry run exits 0"                 "0" "$gpt_rc"
assert_contains  "provider is openrouter"          "$gpt_out" "openrouter"
assert_contains  "base URL has no version suffix"  "$gpt_out" "https://openrouter.ai/api"
assert_not_contains "base URL does not end in /v1" "$gpt_out" "openrouter.ai/api/v1"
assert_contains  "model id is openai/gpt-5.6-sol"  "$gpt_out" "openai/gpt-5.6-sol"
assert_contains  "context is 1050000"              "$gpt_out" "1050000"

# ---------------------------------------------------------------- gemini / openrouter

section "Alias 'gemini' resolves to OpenRouter"

gemini_out="$(CLAUDE_ROUTE_DRYRUN=1 "$CLAUDE_RUN" gemini 2>&1)"
gemini_rc=$?

assert_exit      "dry run exits 0"                 "0" "$gemini_rc"
assert_contains  "provider is openrouter"          "$gemini_out" "openrouter"
assert_contains  "base URL has no version suffix"  "$gemini_out" "https://openrouter.ai/api"
assert_not_contains "base URL does not end in /v1" "$gemini_out" "openrouter.ai/api/v1"
assert_contains  "model id is google/gemini-3.8-flash" "$gemini_out" "google/gemini-3.8-flash"

# 1048576, from OpenRouter's /api/v1/models rather than from an in-session
# reading like glm (Gate A) and gpt (Gate B). The same endpoint reports gpt as
# 1050000, which is exactly what Gate B measured in-session, so it is a
# corroborated source rather than an assumption.
#
# Asserting the exact value guards a specific mistake: 1048576 is 1024^2 and
# gpt is 1050000, so the two OpenRouter routes do NOT share a window. Copying
# gpt's number here, which an earlier draft did, overruns the real window by
# 1424 tokens.
assert_contains  "context is 1048576"                 "$gemini_out" "1048576"
assert_not_contains "context is not gpt's 1050000"    "$gemini_out" "1050000"

# ---------------------------------------------------------------- invariants

section "Invariants that hold on every route"

for out_name in glm_out gpt_out gemini_out; do
  eval "out=\$$out_name"
  alias_name="${out_name%_out}"

  # D5: tool search must stay unset. Setting it true against a proxy that does
  # not forward tool_reference is a hard request failure, not degradation.
  assert_not_contains "[$alias_name] ENABLE_TOOL_SEARCH is never set" \
    "$out" "ENABLE_TOOL_SEARCH="

  # D12: the audit tier stays unmapped so Servanda gates halt loudly rather
  # than running a weak adversarial audit. Gate A Check 4a proved this works.
  assert_not_contains "[$alias_name] audit tier stays unmapped" \
    "$out" "ANTHROPIC_DEFAULT_FABLE_MODEL="

  # D10: telemetry and privacy block applied unconditionally.
  assert_contains "[$alias_name] telemetry is disabled" "$out" "DISABLE_TELEMETRY=1"
  assert_contains "[$alias_name] DO_NOT_TRACK is set"   "$out" "DO_NOT_TRACK=1"
  assert_contains "[$alias_name] OTEL is disabled"      "$out" "OTEL_SDK_DISABLED=true"

  # Gate 0: worth 37.4k of context and removes run-to-run variance.
  assert_contains "[$alias_name] claude.ai connectors are off" \
    "$out" "ENABLE_CLAUDEAI_MCP_SERVERS=false"

  # Empty string, not unset. Unset makes Claude Code authenticate against
  # Anthropic directly, silently defeating the route.
  assert_contains "[$alias_name] ANTHROPIC_API_KEY is explicitly empty" \
    "$out" 'ANTHROPIC_API_KEY=""'

  # No secret may ever reach dry-run output.
  assert_not_contains "[$alias_name] no OpenRouter secret leaks" "$out" "sk-or-"
done

# ---------------------------------------------------------------- errors

section "Error handling"

bogus_out="$(CLAUDE_ROUTE_DRYRUN=1 "$CLAUDE_RUN" no-such-alias 2>&1)"
bogus_rc=$?

assert_exit     "unknown alias exits non-zero" "2" "$bogus_rc"
assert_contains "unknown alias names the bad input" "$bogus_out" "no-such-alias"
assert_contains "unknown alias lists known aliases" "$bogus_out" "glm"
assert_contains "unknown alias lists known aliases" "$bogus_out" "gpt"
assert_contains "unknown alias lists known aliases" "$bogus_out" "gemini"

noargs_out="$("$CLAUDE_RUN" 2>&1)"
noargs_rc=$?

assert_exit     "no arguments exits non-zero"  "2" "$noargs_rc"
assert_contains "no arguments prints usage"    "$noargs_out" "Usage"

# ---------------------------------------------------------------- D6

section "D6: no exec anywhere in the launcher chain"

# Route detection walks process ancestry. An exec replaces the launcher
# process, erasing the ancestor claude-ps looks for.
if grep -nE '^[[:space:]]*exec[[:space:]]' "$CLAUDE_RUN" >/dev/null 2>&1; then
  bad "claude-run contains no 'exec'" "$(grep -nE '^[[:space:]]*exec[[:space:]]' "$CLAUDE_RUN")"
else
  ok "claude-run contains no 'exec'"
fi

# ---------------------------------------------------------------- preflight
#
# The Ollama preflight is the only thing standing between a misconfigured or
# stopped server and a session that fails confusingly several turns in. Gate A
# found the 202752 window depends on OLLAMA_CONTEXT_LENGTH in the server's
# environment and is silent when absent, which is why this is not optional.

section "Ollama preflight: server unreachable"

# Port 1 is closed, so this refuses instantly rather than waiting for a timeout.
# Using a dead port rather than stopping the real server keeps the suite
# non-destructive: it can run while a session is live.
down_out="$(CLAUDE_ROUTE_OLLAMA_PORT=1 "$CLAUDE_RUN" glm 2>&1)"
down_rc=$?

assert_exit     "unreachable server exits non-zero" "6" "$down_rc"
assert_contains "message names the unreachable host" "$down_out" "localhost:1"
assert_contains "message suggests 'ollama serve'"    "$down_out" "ollama serve"
assert_contains "message mentions the host override" "$down_out" "CLAUDE_ROUTE_OLLAMA_HOST"

# Dry run does no network at all, so it must still work with the server down.
# That is the property that makes the rest of this suite runnable anywhere.
downdry_out="$(CLAUDE_ROUTE_DRYRUN=1 CLAUDE_ROUTE_OLLAMA_PORT=1 "$CLAUDE_RUN" glm 2>&1)"
downdry_rc=$?
assert_exit     "dry run still exits 0 with server down" "0" "$downdry_rc"
assert_contains "dry run still resolves the plan" "$downdry_out" "glm-4.7-flash"

section "Ollama preflight: server reachable"

if curl -fsS --max-time 2 http://localhost:11434/api/version >/dev/null 2>&1; then
  pf_out="$(CLAUDE_ROUTE_PREFLIGHT_ONLY=1 "$CLAUDE_RUN" glm 2>&1)"
  pf_rc=$?
  assert_exit     "preflight-only exits 0 against a live server" "0" "$pf_rc"
  assert_contains "preflight reports the server version"  "$pf_out" "Ollama"
  assert_contains "preflight confirms the model"          "$pf_out" "glm-4.7-flash"

  # :latest matters. /api/tags reports "glm-4.7-flash:latest" while the model
  # table says "glm-4.7-flash". A naive string match reports the model missing
  # when it is installed.
  assert_not_contains "installed model is not reported missing" "$pf_out" "not installed"

  # A model that genuinely is not installed must fail, or the check is theater.
  miss_out="$(CLAUDE_ROUTE_PREFLIGHT_ONLY=1 CLAUDE_ROUTE_MODEL=definitely-not-installed "$CLAUDE_RUN" glm 2>&1)"
  miss_rc=$?
  assert_exit     "missing model exits non-zero"      "7" "$miss_rc"
  assert_contains "missing model is named"            "$miss_out" "definitely-not-installed"
  assert_contains "missing model suggests ollama pull" "$miss_out" "ollama pull"
else
  skip "preflight-only exits 0 against a live server" "ollama not running"
  skip "preflight reports the server version"         "ollama not running"
  skip "preflight confirms the model"                 "ollama not running"
  skip "installed model is not reported missing"      "ollama not running"
  skip "missing model exits non-zero"                 "ollama not running"
  skip "missing model is named"                       "ollama not running"
  skip "missing model suggests ollama pull"           "ollama not running"
fi

# ---------------------------------------------------------------- secrets
#
# D11: the OpenRouter key is resolved at launch from 1Password with TouchID
# gating. It is never written to disk, never committed, and must never reach
# dry-run output or a log.

section "OpenRouter secret handling (D11)"

# Dry run must not resolve the secret at all: no TouchID prompt, no network,
# nothing to leak. It should say where the value comes from, not what it is.
gpt_dry="$(CLAUDE_ROUTE_DRYRUN=1 "$CLAUDE_RUN" gpt 2>&1)"

assert_not_contains "dry run leaks no sk-or- token"   "$gpt_dry" "sk-or-"
assert_not_contains "dry run leaks no sk-ant- token"  "$gpt_dry" "sk-ant-"
assert_contains     "dry run names 1Password as the source" "$gpt_dry" "1Password"
assert_contains     "dry run names OPENROUTER_API_KEY as a source" "$gpt_dry" "OPENROUTER_API_KEY"

# T6: OPENROUTER_API_KEY alone is enough, with no 1Password anywhere. This is
# the documented path for the team, so it must work on a PATH with no `op`.
envkey_out="$(PATH=/usr/bin:/bin OPENROUTER_API_KEY="sk-or-v1-PRETEND-ENVONLY" \
  CLAUDE_ROUTE_PREFLIGHT_ONLY=1 "$CLAUDE_RUN" gpt 2>&1)"
envkey_rc=$?
assert_exit         "OPENROUTER_API_KEY alone passes preflight, no op on PATH" "0" "$envkey_rc"
assert_not_contains "OPENROUTER_API_KEY is never echoed" "$envkey_out" "PRETEND-ENVONLY"

# T6 order: OPENROUTER_API_KEY beats ANTHROPIC_AUTH_TOKEN. Told apart by the
# redaction's length marker, so neither value ever has to be printed.
order_out="$(CLAUDE_ROUTE_DRYRUN=1 OPENROUTER_API_KEY="sevench" \
  ANTHROPIC_AUTH_TOKEN="twenty-one-characters" "$CLAUDE_RUN" gpt 2>&1)"
assert_contains "OPENROUTER_API_KEY wins over ANTHROPIC_AUTH_TOKEN" "$order_out" "redacted, 7 chars"

# The redaction must survive a token actually being present, which is the case
# that matters. An override stands in for the real secret so this assertion
# never needs the vault.
leak_out="$(CLAUDE_ROUTE_DRYRUN=1 ANTHROPIC_AUTH_TOKEN="sk-or-v1-DEADBEEFdeadbeefDEADBEEFdeadbeef" \
  "$CLAUDE_RUN" gpt 2>&1)"
assert_not_contains "a present token is redacted, not printed" "$leak_out" "DEADBEEF"
assert_contains     "redaction leaves a visible marker"        "$leak_out" "redacted"

# Redaction must be a denylist, not a prefix allowlist.
#
# This assertion exists because mutation testing found the gap: narrowing the
# match from ANTHROPIC_AUTH_TOKEN=* to ANTHROPIC_AUTH_TOKEN=sk-or-* passed the
# whole suite, because every other token here happens to start with sk-or-. A
# key in any other shape would have printed in full. Anything not explicitly
# known-safe must be redacted, so the token below deliberately looks nothing
# like an OpenRouter key.
oddshape_out="$(CLAUDE_ROUTE_DRYRUN=1 ANTHROPIC_AUTH_TOKEN="totally-unexpected-CREDENTIALSHAPE-9999" \
  "$CLAUDE_RUN" gpt 2>&1)"
assert_not_contains "an unrecognized token shape is still redacted" \
  "$oddshape_out" "CREDENTIALSHAPE"
assert_contains     "unrecognized shape gets the redaction marker" \
  "$oddshape_out" "redacted"

# The one exemption must stay exactly one. Ollama's literal is not a secret.
ollama_tok="$(CLAUDE_ROUTE_DRYRUN=1 "$CLAUDE_RUN" glm 2>&1)"
assert_contains "the ollama literal is exempt, not redacted" \
  "$ollama_tok" "ANTHROPIC_AUTH_TOKEN=ollama"

# T7: the 1Password location is a per-dev default, not a hardcoded constant.
# A shared tool cannot bake in one person's vault, so both halves must be
# overridable from the environment and neither may be readonly.
assert_not_contains "1Password account is not readonly" "$(cat "$CLAUDE_RUN")" "readonly OP_ACCOUNT"
assert_not_contains "1Password item is not readonly"    "$(cat "$CLAUDE_RUN")" "readonly OP_REF"

opovr_dry="$(CLAUDE_ROUTE_DRYRUN=1 CLAUDE_ROUTE_OP_ACCOUNT=example.1password.com \
  CLAUDE_ROUTE_OP_REF='op://Vault/Item/x' "$CLAUDE_RUN" gpt 2>&1)"
assert_contains "CLAUDE_ROUTE_OP_REF overrides the 1Password item"        "$opovr_dry" "op://Vault/Item/x"
assert_contains "CLAUDE_ROUTE_OP_ACCOUNT overrides the 1Password account" "$opovr_dry" "example.1password.com"

# The launch path, against a stub `op` that records how it was called. This
# proves the overrides actually reach `op read`, with no vault and no TouchID.
OP_STUB_DIR="$(mktemp -d)"
cat > "$OP_STUB_DIR/op" <<'STUB'
#!/usr/bin/env bash
printf '%s\n' "$@" > "$(dirname "$0")/op.args"
printf 'sk-or-v1-FROM-OP-STUB'
STUB
chmod +x "$OP_STUB_DIR/op"

opread_out="$(PATH="$OP_STUB_DIR:/usr/bin:/bin" CLAUDE_ROUTE_PREFLIGHT_ONLY=1 \
  CLAUDE_ROUTE_OP_ACCOUNT=example.1password.com CLAUDE_ROUTE_OP_REF='op://Vault/Item/x' \
  "$CLAUDE_RUN" gpt 2>&1)"
opread_rc=$?
opread_args="$(cat "$OP_STUB_DIR/op.args" 2>/dev/null)"
assert_exit         "a configured 1Password item satisfies preflight" "0" "$opread_rc"
assert_contains     "op read receives the overridden item"    "$opread_args" "op://Vault/Item/x"
assert_contains     "op read receives the overridden account" "$opread_args" "example.1password.com"
assert_not_contains "the key read from op is never echoed"    "$opread_out" "FROM-OP-STUB"

# A dev who happens to have `op` installed but never configured an item must
# not get a TouchID prompt for a vault path that is not theirs. Unconfigured
# means unconsulted: they get the missing-credential guidance instead.
rm -f "$OP_STUB_DIR/op.args"
opunset_out="$(PATH="$OP_STUB_DIR:/usr/bin:/bin" "$CLAUDE_RUN" gpt 2>&1)"
opunset_rc=$?
assert_exit     "unconfigured 1Password exits as a missing credential" "4" "$opunset_rc"
if [ -f "$OP_STUB_DIR/op.args" ]; then
  bad "unconfigured 1Password is never consulted" "op was called: $(tr '\n' ' ' < "$OP_STUB_DIR/op.args")"
else
  ok "unconfigured 1Password is never consulted"
fi
assert_contains "unconfigured 1Password says how to configure it" "$opunset_out" "CLAUDE_ROUTE_OP_REF"
rm -rf "$OP_STUB_DIR"

# An override must satisfy the launch path without consulting the vault, which
# is what lets this run unattended and in CI.
ovr_out="$(CLAUDE_ROUTE_PREFLIGHT_ONLY=1 ANTHROPIC_AUTH_TOKEN="sk-or-v1-OVERRIDE-NOT-REAL" \
  "$CLAUDE_RUN" gpt 2>&1)"
ovr_rc=$?
assert_exit         "preflight accepts a token override"  "0" "$ovr_rc"
assert_not_contains "override token is never echoed"      "$ovr_out" "OVERRIDE-NOT-REAL"

# The op guard must name the fix, not just fail. Simulated with a PATH that
# still has an interpreter and coreutils but no `op`, since 1Password installs
# to /opt/homebrew/bin. Emptying PATH entirely would break the script's own
# `#!/usr/bin/env bash` line and test nothing.
if [ -x /usr/bin/op ] || [ -x /bin/op ]; then
  skip "missing op exits non-zero"         "op is in /usr/bin or /bin"
  skip "missing op gives install guidance" "op is in /usr/bin or /bin"
  skip "missing op names the op:// ref"    "op is in /usr/bin or /bin"
else
  noop_out="$(PATH=/usr/bin:/bin ANTHROPIC_AUTH_TOKEN= "$CLAUDE_RUN" gpt 2>&1)"
  noop_rc=$?
  assert_exit     "missing op exits non-zero"         "4" "$noop_rc"
  assert_contains "missing op gives install guidance" "$noop_out" "brew install 1password-cli"
  assert_contains "missing op names the item setting" "$noop_out" "CLAUDE_ROUTE_OP_REF"

  # With no credential at all, the most likely mistake is a teammate who has
  # not set the env var, not one who has not installed 1Password. The message
  # has to lead with the fix for that, and offer 1Password only afterwards.
  assert_contains "missing credential names OPENROUTER_API_KEY" "$noop_out" "OPENROUTER_API_KEY"
  before_env="${noop_out%%OPENROUTER_API_KEY*}"
  before_op="${noop_out%%1Password*}"
  if [ "${#before_env}" -lt "${#before_op}" ]; then
    ok "missing credential names OPENROUTER_API_KEY before 1Password"
  else
    bad "missing credential names OPENROUTER_API_KEY before 1Password" \
      "first line: $(printf '%s' "$noop_out" | head -1)"
  fi
fi

# No .env anywhere near this. The convention is op:// refs resolved at runtime,
# never secrets on disk, and never the two blended together.
#
# Comments are stripped first: the source deliberately *mentions* .env to say it
# is not used, and matching prose would fail on the very comment that documents
# the rule. Only executable lines count.
env_hits="$(sed 's/#.*//' "$CLAUDE_RUN" | grep -nE '(source|\.)[[:space:]]+[^[:space:]]*\.env|\.env["'"'"' ]*$' || true)"
if [ -n "$env_hits" ]; then
  bad "claude-run never reads a .env file" "$env_hits"
else
  ok "claude-run never reads a .env file"
fi

# ---------------------------------------------------------------- wrappers

section "Thin wrappers (D9)"

for wrapper in claude-glm claude-ollama; do
  W="$SCRIPT_DIR/$wrapper"
  if [ ! -x "$W" ]; then
    bad "[$wrapper] exists and is executable" "missing or not executable: $W"
    continue
  fi
  ok "[$wrapper] exists and is executable"

  w_out="$(CLAUDE_ROUTE_DRYRUN=1 "$W" 2>&1)"
  w_rc=$?
  assert_exit     "[$wrapper] dry run exits 0"       "0" "$w_rc"
  assert_contains "[$wrapper] resolves to ollama"    "$w_out" "ollama"
  assert_contains "[$wrapper] resolves the model"    "$w_out" "glm-4.7-flash"
  assert_contains "[$wrapper] carries the context"   "$w_out" "202752"

  # D6 again: an exec in a wrapper erases the ancestor just as effectively as
  # one in the workhorse, and the failure is silent.
  if grep -nE '^[[:space:]]*exec[[:space:]]' "$W" >/dev/null 2>&1; then
    bad "[$wrapper] contains no 'exec'" "$(grep -nE '^[[:space:]]*exec[[:space:]]' "$W")"
  else
    ok "[$wrapper] contains no 'exec'"
  fi

  # Wrappers must forward arguments through to claude, or `claude-glm -p "..."`
  # silently drops the prompt.
  fwd_out="$(CLAUDE_ROUTE_DRYRUN=1 "$W" --sentinel-arg 2>&1)"
  assert_contains "[$wrapper] forwards arguments" "$fwd_out" "--sentinel-arg"
done

for wrapper in claude-gpt claude-openrouter; do
  W="$SCRIPT_DIR/$wrapper"
  if [ ! -x "$W" ]; then
    bad "[$wrapper] exists and is executable" "missing or not executable: $W"
    continue
  fi
  ok "[$wrapper] exists and is executable"

  w_out="$(CLAUDE_ROUTE_DRYRUN=1 "$W" 2>&1)"
  w_rc=$?
  assert_exit     "[$wrapper] dry run exits 0"        "0" "$w_rc"
  assert_contains "[$wrapper] resolves to openrouter" "$w_out" "openrouter"
  assert_contains "[$wrapper] resolves the model"     "$w_out" "openai/gpt-5.6-sol"
  assert_contains "[$wrapper] carries the context"    "$w_out" "1050000"
  assert_not_contains "[$wrapper] leaks no secret"    "$w_out" "sk-or-"

  if grep -nE '^[[:space:]]*exec[[:space:]]' "$W" >/dev/null 2>&1; then
    bad "[$wrapper] contains no 'exec'" "$(grep -nE '^[[:space:]]*exec[[:space:]]' "$W")"
  else
    ok "[$wrapper] contains no 'exec'"
  fi

  fwd_out="$(CLAUDE_ROUTE_DRYRUN=1 "$W" --sentinel-arg 2>&1)"
  assert_contains "[$wrapper] forwards arguments" "$fwd_out" "--sentinel-arg"
done

for wrapper in claude-gemini; do
  W="$SCRIPT_DIR/$wrapper"
  if [ ! -x "$W" ]; then
    bad "[$wrapper] exists and is executable" "missing or not executable: $W"
    continue
  fi
  ok "[$wrapper] exists and is executable"

  w_out="$(CLAUDE_ROUTE_DRYRUN=1 "$W" 2>&1)"
  w_rc=$?
  assert_exit     "[$wrapper] dry run exits 0"        "0" "$w_rc"
  assert_contains "[$wrapper] resolves to openrouter" "$w_out" "openrouter"
  assert_contains "[$wrapper] resolves the model"     "$w_out" "google/gemini-3.8-flash"
  assert_contains "[$wrapper] carries the context"    "$w_out" "1048576"
  assert_not_contains "[$wrapper] leaks no secret"    "$w_out" "sk-or-"

  if grep -nE '^[[:space:]]*exec[[:space:]]' "$W" >/dev/null 2>&1; then
    bad "[$wrapper] contains no 'exec'" "$(grep -nE '^[[:space:]]*exec[[:space:]]' "$W")"
  else
    ok "[$wrapper] contains no 'exec'"
  fi

  fwd_out="$(CLAUDE_ROUTE_DRYRUN=1 "$W" --sentinel-arg 2>&1)"
  assert_contains "[$wrapper] forwards arguments" "$fwd_out" "--sentinel-arg"
done

# ---------------------------------------------------------------- arbitrary models
#
# Aliases are shorthand, not the only way to reach a model. --provider/--model
# name any model the backend serves, with no entry in the model table.
#
# The window is the whole difficulty. Every alias carries a measured context,
# but an arbitrary model has none, and OpenRouter's catalog spans 32768 to
# 1048576. Inheriting whichever alias happened to be named is the bug this
# section exists to prevent: before flags existed, the documented workaround was
# CLAUDE_ROUTE_MODEL=... claude-run gpt, which silently kept gpt's 1050000 and
# would overrun a 65536-window model by 16x.
#
# The catalog is read from a local cache, so these assertions do no network.
# CLAUDE_ROUTE_CACHE_DIR points at a synthetic one: deterministic, offline, and
# it keeps the suite's "no session, no spend" promise intact.

section "Arbitrary models via --provider / --model"

FAKE_CACHE="$(mktemp -d)"
mkdir -p "$FAKE_CACHE/patchbay"
# The nested "context_length" is a decoy. Real records carry one inside
# top_provider as well, so a parser that takes the last match, or any match,
# rather than the record's own reports the wrong window.
printf '%s' '{"data":[{"id":"fake/tiny-model","context_length":4096,"architecture":{"context_length":999999}},{"id":"fake/big-model","context_length":1048576,"architecture":{}}]}' \
  > "$FAKE_CACHE/patchbay/openrouter-models.json"

run_fake() { CLAUDE_ROUTE_CACHE_DIR="$FAKE_CACHE" CLAUDE_ROUTE_DRYRUN=1 "$CLAUDE_RUN" "$@" 2>&1; }

# --- no alias at all, explicit window
fx_out="$(run_fake --provider openrouter --model fake/big-model --context 4242)"
fx_rc=$?
assert_exit     "flags alone resolve with no alias"  "0" "$fx_rc"
assert_contains "flags select the provider"          "$fx_out" "openrouter"
assert_contains "flags select the model"             "$fx_out" "fake/big-model"
assert_contains "explicit --context wins"            "$fx_out" "4242"

# --- --provider omitted entirely, which is how this gets typed in practice.
# Every other assertion here passes --provider, which is exactly why the
# unbound-variable crash on this path survived the first implementation.
fnp_out="$(run_fake --model fake/big-model --context 5150)"
fnp_rc=$?
assert_exit     "--provider may be omitted"          "0" "$fnp_rc"
assert_contains "omitted provider defaults to openrouter" "$fnp_out" "openrouter"
assert_contains "omitted provider still resolves"    "$fnp_out" "5150"
assert_not_contains "no unbound variable crash"      "$fnp_out" "unbound variable"

# --- window comes from the catalog when --context is omitted
fl_out="$(run_fake --provider openrouter --model fake/tiny-model)"
assert_contains "catalog supplies the window"        "$fl_out" "4096"
assert_not_contains "catalog window is not the decoy" "$fl_out" "999999"

# --- THE REGRESSION, in its dangerous spelling.
#
# `claude-run gpt --model X` reads like it should work. It cannot be honoured
# safely (see the guard in claude-run for why parsing flags after the alias is
# not an option), and honouring it half-way is the worst outcome: claude would
# take X while the window stayed on gpt's 1050000. It must fail loudly instead.
fo_out="$(run_fake gpt --model fake/tiny-model)"
fo_rc=$?
assert_exit     "a flag after the alias is refused"  "2" "$fo_rc"
assert_contains "the refusal explains the ordering"  "$fo_out" "before the alias"
assert_not_contains "the refusal launches nothing"   "$fo_out" "1050000"

# The safe spelling of the same intent resolves the window from the catalog.
fo2_out="$(run_fake --model fake/tiny-model gpt)"
assert_contains "flags before the alias re-resolve the window" "$fo2_out" "4096"
assert_not_contains "an overridden model drops the alias window" "$fo2_out" "1050000"

# Same trap through the older env-var spelling, which had no way to notice.
fe_out="$(CLAUDE_ROUTE_CACHE_DIR="$FAKE_CACHE" CLAUDE_ROUTE_DRYRUN=1 \
  CLAUDE_ROUTE_MODEL=fake/tiny-model "$CLAUDE_RUN" gpt 2>&1)"
assert_contains "env-var override also re-resolves"  "$fe_out" "4096"
assert_not_contains "env-var override drops the alias window" "$fe_out" "1050000"

# --- everything claude-run does not own forwards to claude, in order
ff_out="$(run_fake --provider openrouter --model fake/big-model --context 10 --resume Dotfiles)"
assert_contains "claude flags forward"               "$ff_out" "--resume"
assert_contains "claude flag arguments forward"      "$ff_out" "Dotfiles"

# --- =-joined spelling
feq_out="$(run_fake --provider=openrouter --model=fake/big-model --context=77)"
assert_contains "--flag=value is accepted"           "$feq_out" "fake/big-model"
assert_contains "--flag=value carries its value"     "$feq_out" "77"

# --- ollama has no catalog, so an unknown model there must fail loudly
fno_out="$(run_fake --provider ollama --model not-in-any-table)"
fno_rc=$?
assert_exit     "ollama + unknown model exits non-zero" "3" "$fno_rc"
assert_contains "the failure names --context"        "$fno_out" "--context"

# --- an unresolvable window must never be guessed
fmiss_out="$(run_fake --provider openrouter --model fake/absent-from-catalog)"
fmiss_rc=$?
assert_exit     "unknown model exits non-zero"       "3" "$fmiss_rc"
assert_contains "the failure names the model"        "$fmiss_out" "fake/absent-from-catalog"

# --- backward compatibility: the positional form is untouched
fbc_out="$(run_fake gpt --resume Dotfiles)"
assert_contains "positional alias still resolves"    "$fbc_out" "openai/gpt-5.6-sol"
assert_contains "positional alias keeps its window"  "$fbc_out" "1050000"
assert_contains "positional alias still forwards"    "$fbc_out" "Dotfiles"

# --- a non-alias positional is claude's when a model was named, not an error
fpos_out="$(run_fake --provider openrouter --model fake/big-model --context 10 explain this)"
assert_contains "a prompt positional forwards"       "$fpos_out" "explain"

rm -rf "$FAKE_CACHE"

# ---------------------------------------------------------------- launcher/ps sync
#
# claude-ps filters the launcher processes out of its listing with a hardcoded
# alternation of script names. That list and claude-run's KNOWN_ALIASES are two
# copies of the same fact, and nothing forced them to agree: adding the `gemini`
# alias left claude-ps's filter untouched, so a `claude-gemini` session reported
# as two rows, the wrapper and the session itself.
#
# Static rather than behavioural on purpose. The behaviour would need a launched
# session per alias, while the defect is pure drift between two lists, so
# comparing the lists catches it at the source and costs nothing.

section "claude-ps knows every launcher (drift guard)"

ps_filter="$(grep -oE "claude-\\([a-z|-]+\\)" "$SCRIPT_DIR/claude-ps" | head -1)"
known_aliases="$(grep -oE 'KNOWN_ALIASES="[^"]*"' "$CLAUDE_RUN" | head -1 | cut -d'"' -f2)"

if [ -z "$ps_filter" ]; then
  bad "claude-ps has a launcher exclusion list" "no 'claude-(...)' alternation found"
elif [ -z "$known_aliases" ]; then
  bad "claude-run declares KNOWN_ALIASES" "could not parse KNOWN_ALIASES from $CLAUDE_RUN"
else
  ok "claude-ps has a launcher exclusion list"

  # Guard the guard. If either extraction ever goes empty or the alias list
  # stops containing what we know is in it, the loop below would pass by
  # doing nothing at all, which is the failure mode this whole section exists
  # to prevent elsewhere.
  case " $known_aliases " in
    *" glm "*) ok "alias extraction returned a usable list" ;;
    *) bad "alias extraction returned a usable list" "got: '$known_aliases'" ;;
  esac

  for a in $known_aliases; do
    case "$ps_filter" in
      *"($a|"*|*"|$a|"*|*"|$a)"*)
        ok "claude-ps excludes the '$a' launcher" ;;
      *)
        bad "claude-ps excludes the '$a' launcher" \
          "'$a' is a claude-run alias but is missing from claude-ps's filter: $ps_filter" ;;
    esac
  done
fi

# ---------------------------------------------------------------- route detection
#
# D6: claude-ps reads each session's route back out of process ancestry. This
# is the assertion that makes the no-exec rule enforceable rather than merely
# documented, because an exec anywhere in the chain breaks detection silently
# and every routed session would quietly report as plain Anthropic.
#
# A stub `claude` stands in for a real session: it creates the exact ancestry
# without minutes of model loading or a single token of spend.
#
# The route exercised is `gpt`, NOT `glm`, and that choice is load-bearing.
# claude-run runs a per-provider preflight before it launches anything, so the
# glm route exits 6 the moment Ollama is not listening and the stub never
# starts. These three assertions then fail on a machine that is behaving
# perfectly, and they fail in a way that reads like broken detection rather
# than an absent server. That misdiagnosis cost a session on 2026-09-09, which
# recorded the cause as claude-ps having gone transcript-based.
#
# The openrouter preflight, by contrast, returns early when ANTHROPIC_AUTH_TOKEN
# is already set (resolve_openrouter_secret's override path), so a throwaway
# value gets us past it with no 1Password read, no TouchID prompt, no network
# call and no spend. The token below is deliberately not a real key.
#
# Nothing about D6 is provider-specific: the property under test is that the
# launcher chain survives in process ancestry, which is why swapping the route
# costs no coverage. The provider and model asserted below come from claude-ps
# dry-running the alias itself, independently of how the stub was launched.

section "claude-ps route detection (D6)"

CLAUDE_PS="$SCRIPT_DIR/claude-ps"

if [ ! -x "$CLAUDE_PS" ]; then
  bad "claude-ps exists and is executable" "missing: $CLAUDE_PS"
else
  # Count routed rows BEFORE launching anything.
  #
  # Assertions here are relative to this baseline, never absolute. You may
  # legitimately have a real claude-gpt session open while the suite runs, and
  # an absolute count ("exactly one ollama row") fails in that case for no good
  # reason. Learned the hard way on 2026-08-01, when a live routed session made
  # two assertions fail against correct code.
  route_rows() { "$CLAUDE_PS" -n 2>/dev/null | grep -c 'openai/gpt-5.6-sol' || true; }
  baseline_rows="$(route_rows)"
  [ "$baseline_rows" -gt 0 ] && \
    printf '  \033[2m(%d routed session(s) already running; counting relative to that)\033[0m\n' \
      "$baseline_rows"

  STUB_DIR="$(mktemp -d)"
  cat > "$STUB_DIR/claude" <<'STUB'
#!/usr/bin/env bash
# Stands in for a real Claude Code session so route detection can be tested
# without loading a model or spending a token.
sleep 25
STUB
  chmod +x "$STUB_DIR/claude"

  ANTHROPIC_AUTH_TOKEN="selftest-placeholder-not-a-real-key" \
    PATH="$STUB_DIR:$PATH" "$SCRIPT_DIR/claude-gpt" >/dev/null 2>&1 &
  STUB_LAUNCHER_PID=$!

  # Give the chain time to establish: wrapper -> claude-run -> stub.
  sleep 2

  wc_out="$("$CLAUDE_PS" -n 2>&1)"

  assert_contains "routed session shows its provider" "$wc_out" "OpenRouter"
  assert_contains "routed session shows its model"    "$wc_out" "openai/gpt-5.6-sol"

  # The placeholder credential must never reach the listing.
  assert_not_contains "no placeholder credential in the listing" \
    "$wc_out" "selftest-placeholder-not-a-real-key"

  # The launcher processes must not be listed as sessions.
  #
  # claude-run and every wrapper have "claude" in their command line, so the
  # process filter picks them up and one launch reports as three or four rows.
  # Introduced by this launcher family: before it existed, nothing in bin/
  # matched. Caught by the PROVIDER column making the duplicates obvious.
  routed_rows="$(printf '%s' "$wc_out" | grep -c 'openai/gpt-5.6-sol' || true)"
  expected_rows=$((baseline_rows + 1))
  if [ "$routed_rows" -eq "$expected_rows" ]; then
    ok "one launch adds exactly one row"
  else
    bad "one launch adds exactly one row" \
      "expected $expected_rows (baseline $baseline_rows + 1), got $routed_rows; launcher processes may be counted as sessions"
  fi
  assert_not_contains "claude-run is not listed as a session" "$wc_out" "claude-run "
  assert_not_contains "wrappers are not listed as sessions"   "$wc_out" "claude-gpt "

  # A session with no launcher ancestor is reported as Anthropic. Strictly an
  # inference from absence (a process's environment is not readable on macOS),
  # but in practice every unrouted session here is Anthropic; claude-ps says
  # so plainly and keeps the caveat in its comments.
  assert_contains "unrouted sessions are reported as Anthropic" "$wc_out" "Anthropic"

  # Cleanup is scoped to this suite's own temp dir so a real routed session
  # running alongside is never touched.
  kill "$STUB_LAUNCHER_PID" 2>/dev/null
  pkill -f "$STUB_DIR/claude" 2>/dev/null
  wait "$STUB_LAUNCHER_PID" 2>/dev/null
  rm -rf "$STUB_DIR"
  sleep 1

  # Detection must not keep claiming a route for a session that has ended.
  # Again relative: back to baseline, not to zero.
  after_rows="$(route_rows)"
  if [ "$after_rows" -eq "$baseline_rows" ]; then
    ok "the route disappears when the session does"
  else
    bad "the route disappears when the session does" \
      "expected $baseline_rows, got $after_rows"
  fi
fi

# ---------------------------------------------------------------- de-personalization
#
# These scripts ship to other people. The next person to hardcode something
# convenient (a vault path, an account, a name) would reintroduce the exact
# problem the team release removed, silently, so this makes it loud.
#
# Globbed, not enumerated. The launcher list drifted once already: claude-gemini
# was added on 2026-09-10 and an enumerated check would have quietly stopped
# covering it. A guard that can be outgrown by adding a file is not one.
#
# The pattern is assembled from split literals so this file does not trip its
# own check. The planted-string assertion below proves the split still matches.

section "De-personalization: no launcher names one person"

personal_pat="facet""digital|scott""wb|Sco""tt|op://Emp""loyee"
launcher_files=("$SCRIPT_DIR"/claude-*)

if [ ! -e "${launcher_files[0]}" ]; then
  bad "the launcher glob matches files" "nothing matched $SCRIPT_DIR/claude-*"
else
  ok "the launcher glob matches files (${#launcher_files[@]} scanned)"

  # Guard the guard: a pattern that matches nothing would pass by doing nothing.
  if printf '%s\n' "op://Emp""loyee/x" | grep -qE "$personal_pat"; then
    ok "the personal-string pattern detects a planted value"
  else
    bad "the personal-string pattern detects a planted value" "pattern: $personal_pat"
  fi

  personal_hits="$(grep -nE "$personal_pat" "${launcher_files[@]}" 2>/dev/null || true)"
  if [ -n "$personal_hits" ]; then
    bad "no launcher file carries personal identifiers" "$personal_hits"
  else
    ok "no launcher file carries personal identifiers"
  fi
fi

# ---------------------------------------------------------------- summary

TOTAL=$((PASS + FAIL))
printf '\n'
if [ "$FAIL" -eq 0 ]; then
  printf '\033[32m✓ PASS\033[0m  %d/%d assertions' "$PASS" "$TOTAL"
  [ "$SKIP" -gt 0 ] && printf ', \033[33m%d skipped\033[0m' "$SKIP"
  printf '\n\n'
  exit 0
else
  printf '\033[31m✗ FAIL\033[0m  %d/%d passed, %d failed' "$PASS" "$TOTAL" "$FAIL"
  [ "$SKIP" -gt 0 ] && printf ', %d skipped' "$SKIP"
  printf ':'
  printf '%b\n\n' "$FAILED_NAMES"
  exit 1
fi
