#!/usr/bin/env bash
#
# what-claude.sh - Show all running Claude Code processes, their install type,
#                  backend route, and working directory.
#
set -euo pipefail

# How many ancestor levels to walk looking for a route launcher. Three covers
# the deepest real chain (wrapper -> claude-run -> claude) with a level spare.
readonly ROUTE_ANCESTRY_DEPTH=3

# Resolve an alias to "provider model" by asking claude-run itself, so the
# model table stays in exactly one place. Results are memoized because several
# sessions commonly share an alias.
ROUTE_CACHE=""
resolve_route_alias() {
  local alias="$1" claude_run plan provider model cached

  cached="$(printf '%s' "$ROUTE_CACHE" | sed -n "s/^${alias}=//p" | head -1)"
  if [ -n "$cached" ]; then printf '%s' "$cached"; return 0; fi

  claude_run="$(command -v claude-run 2>/dev/null || true)"
  [ -z "$claude_run" ] && claude_run="$(dirname "${BASH_SOURCE[0]}")/claude-run"

  if [ ! -x "$claude_run" ]; then
    printf '%s' "$alias"
    return 0
  fi

  # Dry run touches no network and launches nothing, so this is safe to call
  # from a status tool.
  plan="$(CLAUDE_ROUTE_DRYRUN=1 "$claude_run" "$alias" 2>/dev/null || true)"
  provider="$(printf '%s' "$plan" | sed -n 's/^  provider  *//p' | head -1)"
  model="$(printf '%s' "$plan"    | sed -n 's/^  model  *//p'    | head -1)"

  if [ -n "$provider" ] && [ -n "$model" ]; then
    ROUTE_CACHE="${ROUTE_CACHE}${alias}=${provider} ${model}"$'\n'
    printf '%s %s' "$provider" "$model"
  else
    printf '%s' "$alias"
  fi
}

# Read a session's route out of its process ancestry.
#
# D6: this is why no launcher in the chain may use `exec`. An exec replaces the
# launcher process with claude, erasing the very ancestor matched here, and
# every routed session would silently report as plain Anthropic.
detect_route() {
  local pid="$1" cmd="$2" ancestor acmd i alias

  # Preserve the pre-existing claude-code-router detection.
  if echo "$cmd" | grep -q 'claude-code-router'; then
    printf 'claude-code-router'
    return 0
  fi

  ancestor="$pid"
  for ((i = 0; i < ROUTE_ANCESTRY_DEPTH; i++)); do
    ancestor=$(ps -o ppid= -p "$ancestor" 2>/dev/null | tr -d ' ')
    [ -z "$ancestor" ] && break
    [ "$ancestor" -le 1 ] 2>/dev/null && break
    acmd=$(ps -o command= -p "$ancestor" 2>/dev/null || true)
    [ -z "$acmd" ] && continue

    # Named wrappers carry their alias implicitly; claude-run carries it as its
    # first argument.
    case "$acmd" in
      *claude-run*)
        alias=$(echo "$acmd" | sed -n 's/.*claude-run[[:space:]]\{1,\}\([^[:space:]-][^[:space:]]*\).*/\1/p')
        [ -n "$alias" ] && { resolve_route_alias "$alias"; return 0; }
        ;;
      *claude-glm*)        resolve_route_alias glm; return 0 ;;
      *claude-gpt*)        resolve_route_alias gpt; return 0 ;;
      *claude-ollama*)     resolve_route_alias glm; return 0 ;;
      *claude-openrouter*) resolve_route_alias gpt; return 0 ;;
    esac
  done

  # No launcher ancestor. This is an inference from absence, not an
  # observation: the environment of a running process is not readable on macOS
  # (`ps eww` returns nothing), so a session started some other way with
  # ANTHROPIC_BASE_URL exported would look identical to a plain one. Say so
  # rather than reporting it as fact.
  printf 'anthropic (inferred)'
  return 0
}

# Gather claude processes, excluding Claude Desktop (Electron app)
pids=()
while IFS= read -r line; do
  pid=$(echo "$line" | awk '{print $2}')
  pids+=("$pid")
done < <(ps aux | grep -E '[c]laude' \
  | grep -v 'Claude\.app' \
  | grep -v 'Claude Helper' \
  | grep -v 'Claude Renderer' \
  | grep -v 'what-claude' \
  | grep -v 'shell-snapshots' \
  | grep -vE 'claude-(run|glm|gpt|ollama|openrouter|route-selftest)')
  # ^ The route launchers themselves. Every one has "claude" in its command
  #   line, so without this a single `claude-glm` reports as three or four
  #   rows: the wrapper, claude-run, and the session it started. They are the
  #   scaffolding around a session, not sessions.
  #
  #   This exclusion is why the launchers must not be renamed casually, and it
  #   is deliberately narrow: `claude-code-router` is NOT excluded, because it
  #   is a real routing layer worth reporting.

if [ ${#pids[@]} -eq 0 ]; then
  echo "No running Claude Code processes found."
  exit 0
fi

# Collect info for each process
declare -a rows=()
for pid in "${pids[@]}"; do
  # The ps snapshot above and the per-PID lookups below are separate moments,
  # so a short-lived process can appear in the list and be gone by now. It then
  # renders as a row of "unknown" with no working directory, which looks like a
  # broken session rather than the race it is. Drop it.
  ps -p "$pid" >/dev/null 2>&1 || continue

  # Working directory
  cwd=$(lsof -a -p "$pid" -d cwd -Fn 2>/dev/null | grep '^n' | sed 's/^n//' || echo "unknown")

  # Determine install type from the executable/libraries
  txt=$(lsof -a -p "$pid" -d txt -Fn 2>/dev/null | grep -E '(claude|node)' | head -1 | sed 's/^n//' || true)
  cmd=$(ps -p "$pid" -o command= 2>/dev/null || echo "unknown")

  if echo "$txt" | grep -q '\.local/share/claude'; then
    install="native"
  elif echo "$txt" | grep -q 'homebrew.*node'; then
    # Figure out which npm package
    if echo "$cmd" | grep -q 'claude-code-router'; then
      install="npm (claude-code-router)"
    else
      install="npm (homebrew node)"
    fi
  elif echo "$cmd" | grep -q '\.local/share/claude'; then
    install="native"
  else
    install="unknown"
  fi

  # Shorten cwd for display: replace $HOME with ~
  display_cwd=$(echo "$cwd" | sed "s|^$HOME|~|")

  route=$(detect_route "$pid" "$cmd")

  rows+=("${pid}|${install}|${route}|${display_cwd}")
done

# Size the ROUTE column to its contents. Routed model ids vary a lot in length
# ("glm-4.7-flash" against "openai/gpt-5.6-sol"), so a fixed width either
# truncates or leaves a gap.
route_w=5   # len("ROUTE")
for row in "${rows[@]}"; do
  IFS='|' read -r _ _ r _ <<< "$row"
  [ ${#r} -gt "$route_w" ] && route_w=${#r}
done

dashes() { printf '%*s' "$1" '' | tr ' ' '-'; }

printf "\n"
printf "  %-8s  %-24s  %-*s  %s\n" "PID" "INSTALL" "$route_w" "ROUTE" "WORKING DIRECTORY"
printf "  %-8s  %-24s  %-*s  %s\n" \
  "$(dashes 8)" "$(dashes 24)" "$route_w" "$(dashes "$route_w")" "$(dashes 40)"
for row in "${rows[@]}"; do
  IFS='|' read -r pid install route dir <<< "$row"
  printf "  %-8s  %-24s  %-*s  %s\n" "$pid" "$install" "$route_w" "$route" "$dir"
done
printf "\n"

# Only worth explaining when the word actually appears in the table.
if printf '%s\n' "${rows[@]}" | grep -q 'inferred'; then
  printf "  i 'anthropic (inferred)' means no route launcher was found in the\n"
  printf "    process ancestry, not that Anthropic was observed. A running\n"
  printf "    process's environment is not readable on macOS.\n\n"
fi
