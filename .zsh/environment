export PATH=$PATH:~/bin
export SVN_EDITOR=vi
export EDITOR=vi

# pipx and friends install here
export PATH="$PATH:$HOME/.local/bin"

# Where claude-run finds the OpenRouter key in 1Password. Paths, not secrets.
export CLAUDE_ROUTE_OP_ACCOUNT="facetdigital.1password.com"
export CLAUDE_ROUTE_OP_REF="op://Employee/OpenRouter/API Key"
# Ollama server settings (apply to shell-launched 'ollama serve').
# 0.0.0.0 binding is intentional: exposes the API to LAN/Tailscale
# so other machines can use this box for inference.
export OLLAMA_CONTEXT_LENGTH=262144
export OLLAMA_HOST=0.0.0.0:11434
export OLLAMA_KEEP_ALIVE=1h

