alias ls=ls

# Directory Shortcuts
alias src="cd ~/src && pwd"

# Git
alias gb="git branch"
alias gbc="git branch-create"
alias gbd="git branch-delete"
alias gs="git status -s"
alias gsm="git status -s -uno"
alias gss="git stash save"
alias gsl="git stash list"
alias gsa="git stash apply"
alias gsp="git stash pop"
alias gd="git diff"
alias gco="git checkout"
alias gci="git commit -a"
alias gm="git merge --no-ff"
alias gmnc="git merge --no-ff --no-commit"
alias gpl="git pull --log"
alias cdr="cd ./\$(git rev-parse --show-cdup)"

# tmux
alias tmn="tmux new -s "
alias tma="tmux attach -t "
alias tmls="tmux ls | sed 's/: \([0-9]*\) windows (created \(.*\))/|\1 windows|\2/' | column -t -s '|'"
alias tmh="less ~/.tmux.cheatsheet.txt"

# Heroku
alias deploy="git push heroku master"
alias pev2-health-check="heroku run rails runner scripts/daily-health-check.rb -a prepare-enrich"

# DevContainers: shell into the current repo's devcontainer (repo must have .devcontainer/dc)
alias dcsh='./.devcontainer/dc sh'

# Misc Utilities
alias SmartSynchronize="/Applications/SmartSynchronize.app/Contents/MacOS/SmartSynchronize"
alias zipp='zip -er'
alias tcpdump-rails="tcpdump -c 20 -s 0 -i lo0 -A tcp port 3000"

# Load the Slack user token into the current shell for agent launches
# (TouchID via 1Password once; children inherit it). Safe to keep in a public
# repo: the alias holds only the op:// reference, never the secret.
alias agent-env-slack='export SLACK_USER_TOKEN=$(op read --account facetdigital.1password.com "op://Employee/Slack User API Token - Facet/credential")'

# Same shape for HubSpot. Donna's 5:27 pre-collection shells out to the Facet
# admin workspace collector, which exits 3 without HUBSPOT_TOKEN. Referenced by
# item ID, not name: op:// paths reject the parentheses in "HubSpot (SWB)" and
# fail silently to an empty variable. The ID survives renames, not vault moves.
alias agent-env-hubspot='export HUBSPOT_TOKEN=$(op read --account facetdigital.1password.com "op://Employee/xnaq6dm665fzfxg54owmxucxve/PAT")'

# Both at once, for a normal Donna launch.
alias agent-env='agent-env-slack; agent-env-hubspot'
