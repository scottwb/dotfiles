alias ls=ls

# Directory Shortcuts
alias src="cd ~/src && pwd"

# Git
alias gb="git branch"
alias gbc="git branch-create"
alias gbd="git branch-delete"
alias gs="git status -s"
alias gsm="git status -s -uno"
alias gss="git stash save"
alias gsl="git stash list"
alias gsa="git stash apply"
alias gsp="git stash pop"
alias gd="git diff"
alias gco="git checkout"
alias gci="git commit -a"
alias gm="git merge --no-ff"
alias gmnc="git merge --no-ff --no-commit"
alias gpl="git pull --log"
alias cdr="cd ./\$(git rev-parse --show-cdup)"

# tmux
alias tmn="tmux new -s "
alias tma="tmux attach -t "
alias tmls="tmux ls | sed 's/: \([0-9]*\) windows (created \(.*\))/|\1 windows|\2/' | column -t -s '|'"
alias tmh="less ~/.tmux.cheatsheet.txt"

# Heroku
alias deploy="git push heroku master"
alias pev2-health-check="heroku run rails runner scripts/daily-health-check.rb -a prepare-enrich"

# DevContainers: shell into the current repo's devcontainer (repo must have .devcontainer/dc)
alias dcsh='./.devcontainer/dc sh'

# Misc Utilities
alias SmartSynchronize="/Applications/SmartSynchronize.app/Contents/MacOS/SmartSynchronize"
alias zipp='zip -er'
alias tcpdump-rails="tcpdump -c 20 -s 0 -i lo0 -A tcp port 3000"
